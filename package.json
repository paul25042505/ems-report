{
  "name": "ems-report",
  "version": "0.1.0",
  "private": true,
  "description": "國防知性之旅 救護站資訊回報系統",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts --demo"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.0",
    "leaflet": "1.9.4",
    "next": "15.5.28",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
