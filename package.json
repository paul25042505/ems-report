{
  "name": "ems-report",
  "version": "0.1.0",
  "private": true,
  "description": "國防知性之旅 救護站資訊回報系統",
  "scripts": {
    "dev": "firebase emulators:exec --only firestore,auth --project demo-ems \"tsx scripts/seed.ts && next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "leaflet": "1.9.4",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "firebase-tools": "15.34.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
